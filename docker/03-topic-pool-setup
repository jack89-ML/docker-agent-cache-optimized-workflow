#!/command/with-contenv sh
# shellcheck shell=sh
# 03-topic-pool-setup — applica la config al PRIMO avvio (volume vuoto).
# Parametri via env: FREETOKEN_BASE_URL (default http://127.0.0.1:1920/v1),
#                    MODEL_NAME (default qwen36-35b)
DATA="${HERMES_HOME:-/opt/data}"

if [ ! -f "$DATA/.topic-pool-seeded" ] && [ -f /opt/setup/config.template.yaml ]; then
  echo "[topic-pool] primo avvio: genero config.yaml"
  FT_URL="${FREETOKEN_BASE_URL:-http://127.0.0.1:1920/v1}"
  MODEL="${MODEL_NAME:-qwen36-35b}"
  sed -e "s|{FREETOKEN_BASE_URL}|$FT_URL|g" -e "s|{MODEL_NAME}|$MODEL|g" \
      /opt/setup/config.template.yaml > "$DATA/config.yaml"
  touch "$DATA/.topic-pool-seeded"
  chown -R 10000:10000 "$DATA"
  echo "[topic-pool] config applicata (modello: $MODEL)"
else
  echo "[topic-pool] gia configurato o nessun template"
fi
